{
  "name": "inventario-app",
  "version": "1.0.5",
  "description": "Sistema de Control de Inventario - U.E. Corazón Nuevo",
  "repository": {
    "type": "git",
    "url": "https://github.com/MauriVC/Inventario_Articulos.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "concurrently -n BACK,FRONT -c blue,green \"npm run dev --prefix ../inventario-backend\" \"vite\"",
    "start:electron": "concurrently -n FRONT,ELEC -c green,blue \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "vite build && electron-builder",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "rebuild-sqlite": "cd ../inventario-backend && npx @electron/rebuild -f -w better-sqlite3 -v 33.0.0",
    "rebuild-sqlite-local": "cd ../inventario-backend && npm rebuild better-sqlite3",
    "electron:build": "npm run rebuild-sqlite && vite build && electron-builder && npm run rebuild-sqlite-local",
    "prebuild": "npm run rebuild-sqlite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/tests/unit",
    "test:components": "vitest run src/tests/components"
  },
  "build": {
    "appId": "com.inventario.uecorazonnuevo",
    "productName": "Sistema de Almacenes",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../inventario-backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.cache/**/*",
          "!node_modules/nodemon/**/*",
          "!tests/**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Sistema-de-Almacenes-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MauriVC",
        "repo": "Inventario_Articulos"
      }
    ]
  },
  "dependencies": {
    "@vueuse/core": "^11.0.0",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-vue-next": "^0.460.0",
    "mysql2": "^3.22.5",
    "sweetalert2": "^11.26.25",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^29.1.1",
    "vite": "^5.4.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5"
  }
}
